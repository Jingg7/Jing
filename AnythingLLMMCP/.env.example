# AnythingLLM MCP Server 配置模板
# 复制为 .env 后填入真实值；.env 已在 .gitignore 中忽略，不要提交真实密钥。

# AnythingLLM REST API 地址（AnythingLLM 桌面版/单用户版默认 http://localhost:3001/api）
ANYTHINGLLM_BASE_URL=http://localhost:3001/api

# 在 AnythingLLM 侧边栏 Settings -> Tools -> Developer API 生成
ANYTHINGLLM_API_KEY=your_anythingllm_api_key

# 单次上游请求超时（秒）
ANYTHINGLLM_TIMEOUT=30

# MCP Server 监听地址与端口。两个 MCP Server 同时运行时端口不能冲突。
MCP_HOST=127.0.0.1
MCP_PORT=8001
